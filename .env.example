# ─────────────────────────────────────────────────────────────────────────
# SA Auto Match — environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (server-side only) ─────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# SERVICE ROLE key. Bypasses Row Level Security — server-side use ONLY.
# NEVER expose this to the browser and NEVER use the anon key here.
SUPABASE_SERVICE_ROLE_KEY=

# ── ClickUp ─────────────────────────────────────────────────────────────
# Personal API token (pk_...) or workspace token. Sent verbatim in the
# Authorization header (no "Bearer" prefix).
CLICKUP_API_TOKEN=

# Target ClickUp list id for new lead tasks.
CLICKUP_LIST_ID=901114100607

# ── Resend (optional lead-alert email) ──────────────────────────────────
# If any of these three are unset, email alerts are silently skipped.
RESEND_API_KEY=
# Verified sender, e.g. "SA Auto Match <leads@yourdomain.com>"
ALERT_EMAIL_FROM=
# Recipient(s). Comma-separate for multiple, e.g. "sales@x.com,manager@x.com"
ALERT_EMAIL_TO=

# ── Firecrawl (inventory extraction) ───────────────────────────────────
# Keep this server-side only. Do not prefix with NEXT_PUBLIC_.
FIRECRAWL_API_KEY=
# Optional self-hosted endpoint; leave blank when using cloud Firecrawl.
FIRECRAWL_API_URL=

# ── Meta Pixel (client-side, public) ────────────────────────────────────
# Exposed to the browser (NEXT_PUBLIC_ prefix). Used by the funnel frontend.
NEXT_PUBLIC_META_PIXEL_ID=
ENABLE_INVENTORY_PREVIEWS=false
NEXT_PUBLIC_CONTACT_EMAIL=
