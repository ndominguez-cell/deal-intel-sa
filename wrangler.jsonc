{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deal-intel-sa",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["MARKETCHECK_API_KEY", "AUTODEV_API_KEY"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Workers Paid: each sync makes ~2 provider calls per vehicle per page
  // across MarketCheck and Auto.dev, and the Texas index refresh makes ~81
  // (up to ~243 with retries), well over the Free plan's 50-request cap.
  "limits": {
    "subrequests": 10000
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // The Texas index cron must match TEXAS_INDEX_CRON in worker/index.ts:
  // 12:00 UTC daily inventory sync; 11:15 UTC Tuesdays Texas market index refresh (~77 MarketCheck calls).
  "triggers": {
    "crons": ["0 12 * * *", "15 11 * * 2"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deal-intel-sa-db",
      "database_id": "989bf4a9-00e9-4f4b-8b69-57000ea1ec29",
      "migrations_dir": "migrations"
    }
  ]
}
