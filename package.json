{
  "name": "deal-intel-sa",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev --config vite.config.cloudflare.ts",
    "build": "npm run build:cloudflare",
    "build:cloudflare": "vite build --config vite.config.cloudflare.ts",
    "types:cloudflare": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --include-runtime=false",
    "check:cloudflare": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --include-runtime=false --check && tsc -p tsconfig.worker.json --incremental false",
    "preview:cloudflare": "vite preview --config vite.config.cloudflare.ts",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config dist/public/deal_intel_sa/wrangler.json",
    "start": "npm run preview:cloudflare",
    "check": "npm run check:cloudflare",
    "test": "tsx --test 'server/**/*.test.ts'",
    "db:migrate:local": "wrangler d1 migrations apply deal-intel-sa-db --local --persist-to client/.wrangler/state --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply deal-intel-sa-db --remote --config wrangler.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "simple-icons": "^16.34.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vite": "^7.1.9",
    "wrangler": "^4.120.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
